<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+ Live Updates / Promoted Ongoing Notifications permission -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Battery optimization whitelist request for reliable background listening -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Least-privilege package visibility for preset delivery apps -->
    <queries>
        <package android:name="com.sankuai.meituan" />
        <package android:name="me.ele" />
        <package android:name="com.jingdong.app.mall" />
        <package android:name="com.sankuai.meituan.takeoutnew" />
        <package android:name="com.taobao.taobao" />
    </queries>

    <application
        android:name=".LiveDeliveryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background NotificationListenerService for delivery notifications -->
        <service
            android:name=".service.DeliveryNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>

        <!-- Receiver to handle user dismissing a Live Notification or clicking Dismiss action -->
        <receiver
            android:name=".notification.LiveNotificationActionReceiver"
            android:exported="false" />

    </application>

</manifest>
